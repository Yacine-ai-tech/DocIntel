# DocIntel — Vision-first document AI pipeline
# Copy this file to .env and fill in your values.
#
# ─────────────────────────────────────────────────────────────────────────────
# ROUTE ARCHITECTURE:
#   Route A  →  Claude Sonnet 4.6 Vision (premium quality, requires ANTHROPIC_API_KEY)
#   Route B  →  Ollama vision model (open-weight, your GPU or a cloud Ollama endpoint)
#   Route C  →  Tesseract OCR + LLM cleanup (automatic fallback, no GPU needed)
# ─────────────────────────────────────────────────────────────────────────────

# ─── Route A: Claude Vision (premium) ────────────────────────────────────────
ANTHROPIC_API_KEY=
LLM_VISION_ROUTE_A=anthropic/claude-sonnet-4-6

# ─── Route B: Ollama Vision (local / self-hosted only — no third-party API) ──
#
# Route B never calls a third-party inference provider (no Groq, no HF, no cloud
# vision API). Both modes below talk to an Ollama-compatible server you run yourself —
# the only difference is where it's hosted.
#
# Step 1: Choose your deployment mode
#   local  = Ollama runs on this same machine/container as the DocIntel app
#   remote = Ollama runs on hardware you control elsewhere (your own GPU rig, a
#            box you rent and self-host Ollama on) — same LAN or reachable over
#            the internet via a tunnel/VPN/public IP. Still your own hardware.
#
ROUTE_B_MODE=local

# Step 2: Choose your Ollama vision model
#   Any Ollama vision model works. These are the recommended options:
#   - qwen2.5vl:7b       lighter, works on most GPUs (recommended default)
#   - llama3.2-vision:11b  better quality, requires CUDA compute ≥ 7.5
#   - llama3.2-vision:90b  highest quality, needs large GPU
#   Run: ollama pull qwen2.5vl:7b
#
OLLAMA_MODEL=qwen2.5vl:7b

# Optional: if your primary model fails due to GPU incompatibility, auto-retry with this
OLLAMA_FALLBACK_MODEL=qwen2.5vl:7b

# ── LOCAL mode settings ───────────────────────────────────────────────────────
# (only relevant when ROUTE_B_MODE=local)
#
# Where your Ollama instance is running:
#   - Same machine:  http://localhost:11434   (default)
#   - Docker:        http://ollama:11434
#   - LAN server:    http://192.168.1.100:11434
#
OLLAMA_HOST=http://localhost:11434

# ── REMOTE mode settings ──────────────────────────────────────────────────────
# (only relevant when ROUTE_B_MODE=remote)
#
# ROUTE_B_REMOTE_ENDPOINT must point at an Ollama-compatible server that YOU host —
# never a third-party inference API (no Groq, no HF router, no other hosted vision
# API — those aren't "local" and defeat the point of Route B). Examples:
#
#   Your own GPU rig/workstation on the LAN:
#     ROUTE_B_REMOTE_ENDPOINT=http://192.168.1.50:11434
#
#   Your own on-demand GPU host, reachable over the internet (via a tunnel/VPN):
#     ROUTE_B_REMOTE_ENDPOINT=https://inference.your-domain.app
#
#   Self-hosted Ollama on a VPS/server you rent:
#     ROUTE_B_REMOTE_ENDPOINT=http://your-server-ip:11434
#
ROUTE_B_REMOTE_ENDPOINT=

# Bearer token for the remote endpoint — only needed if you've put your own auth
# (e.g. a reverse proxy) in front of your self-hosted Ollama. Leave blank otherwise.
ROUTE_B_REMOTE_TOKEN=

# Override the model tag sent to the remote endpoint (optional) — only needed if
# your remote Ollama uses a different tag name than OLLAMA_MODEL above.
ROUTE_B_REMOTE_MODEL=

# Timeout in seconds for Route B inference calls (default: 60).
#
# 60s suits a LOCAL Ollama with the model already resident. A REMOTE endpoint that
# wakes on demand has to load the vision model before it can answer the first
# request, and a ~6GB checkpoint (qwen2.5vl:7b) on a CPU-tier host measured ~122s
# cold — so the default guarantees a timeout on the first call after any idle
# period, then succeeds on the retry once the model is warm. If ROUTE_B_MODE=remote,
# raise this to cover a cold start (300 is a safe starting point).
ROUTE_B_TIMEOUT=60

# Max concurrent chunks when processing large multi-page PDFs with Route B.
# Keep at 1 (sequential) for local/single-GPU setups. Raise for high-end remote endpoints.
ROUTE_B_CHUNK_CONCURRENCY=1

# (Advanced) Pages per Route B chunk — Ollama has smaller context than Claude.
VISION_PAGES_PER_CALL_LOCAL=2

# ─── Route C: OCR Fallback ────────────────────────────────────────────────────
# Model for OCR text → structured JSON cleanup. Cost-optimized.
LLM_CLEANUP=anthropic/claude-haiku-4-5

# Optional: Surya (layout-aware OCR, stronger than plain Tesseract), tried first within
# Route C's OCR step when enabled, falling back to Tesseract on failure/when disabled.
# Off by default — Surya's real dependency chain (torch + torchvision + transformers) is
# the same class of heavy ML stack as Route B's vision models, not something to install
# uninvited. Same local/remote split as Route B (services/route_b.py):
#   local  (default) — surya-ocr installed in this same process (see requirements-ml.txt)
#   remote            — offload to an OCR-serving HTTP endpoint you host yourself; POST
#                        {endpoint}/ocr with {"image_b64": ...} must return
#                        {"text": ..., "lines": [...]} — a generic contract, not tied to
#                        any specific server implementation.
SURYA_ENABLED=false
SURYA_MODE=local
SURYA_REMOTE_ENDPOINT=
SURYA_REMOTE_TOKEN=

# ─── General LLM Settings ────────────────────────────────────────────────────
LLM_DEFAULT=groq/llama-3.3-70b-versatile
LLM_REASONING=anthropic/claude-sonnet-4-6

# API Keys (only needed for the features you use)
# GROQ_API_KEY / HF_TOKEN are for LLM_DEFAULT text calls only — Route B vision
# never uses these; it only ever talks to Ollama you host yourself (see above).
GROQ_API_KEY=
HF_TOKEN=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── Performance & Limits ─────────────────────────────────────────────────────
MAX_PDF_PAGES=200
BATCH_MAX_CONCURRENCY=5
VISION_PAGES_PER_CALL=8

# Optional: offload PDF page rasterization for very large PDFs to a remote host you
# control, so a small app tier never holds every decoded page in RAM. No-op unless
# RENDER_URL is set; small/medium PDFs always render locally regardless.
RENDER_URL=
RENDER_PAGE_THRESHOLD=8
RENDER_TIMEOUT=180
PDF_MAX_EDGE_PX=1600
# Bearer token for RENDER_URL (only relevant if you've set RENDER_URL and put auth in
# front of it). Also used as the bearer token for Route B-adjacent remote inference
# calls that expect an Authorization header — same secret-gating pattern as
# ROUTE_B_REMOTE_TOKEN above, just under the historical env var name.
INFERENCE_TOKEN=

# ─── CORS & Security ──────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:8001,http://localhost:3000
OMNIINTEL_INTERNAL_TOKEN=
REQUIRE_INTERNAL_TOKEN=false

# ─── Mobile camera-scan pairing (services/camera.py) ─────────────────────────
# The public URL your PHONE's browser should open when it scans the pairing QR —
# i.e. wherever the frontend is actually reachable from, not the backend's own host.
# Must be HTTPS (or "localhost") for most mobile browsers to allow camera capture at
# all — see SELF_HOSTING.md if you're serving over plain HTTP on a LAN.
FRONTEND_URL=http://localhost:8001

# ─── Logging & Telemetry ──────────────────────────────────────────────────────
LOG_LEVEL=INFO

# Anonymous startup ping (service name + a random, locally-generated, non-hardware-derived
# install ID — see TELEMETRY.md for exactly what's sent). Set to true to disable entirely.
TELEMETRY_OPT_OUT=false
# Where the ping goes. Defaults to the upstream DocIntel project's adoption-tracking
# endpoint; override or leave OPT_OUT=true if you don't want to report to it.
TELEMETRY_URL=https://gateway.ysiddo-ai-projects.app/telemetry

# Playwright E2E testing credentials
E2E_ADMIN_PASSWORD=change_me_e2e_password
