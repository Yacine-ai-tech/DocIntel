POSTGRES_URL=postgresql://user:password@localhost/dbname

# ADMIN_PASS: password for the E2E test admin login, must match the deployed admin account
ADMIN_PASS=
# OMNIINTEL_INTERNAL_TOKEN: shared secret for internal service-to-service auth, must match the value configured on the gateway and all other OmniIntel services
OMNIINTEL_INTERNAL_TOKEN=
