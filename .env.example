# ==========================================
# DOCINTEL — .env.example
# Copy to .env and fill in real values.
# Never commit .env to git.
# ==========================================

# ── Database (your own Neon Postgres project for DocIntel) ─────────────────────
POSTGRES_URL=postgresql://docintel_owner:<password>@<endpoint>.neon.tech/docintel?sslmode=require

# ── Route A — Claude Vision (premium, complex layouts) ────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Route B — Ollama Vision (open-source, local GPU or remote endpoint) ────────
# Mode: local (run Ollama on this machine) | remote (call a remote endpoint)
ROUTE_B_MODE=remote

# If ROUTE_B_MODE=remote: URL of the Ollama-compatible endpoint
# Supported: your Orchestrator /api/chat | Groq API | self-hosted Ollama on VPS
ROUTE_B_REMOTE_ENDPOINT=https://your-orchestrator.onrender.com/api/chat
ROUTE_B_REMOTE_TOKEN=your_orchestrator_or_provider_token_here

# If ROUTE_B_MODE=local: local Ollama host (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Vision model — any Ollama vision model: qwen2.5vl:7b | llama3.2-vision:11b
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_FALLBACK_MODEL=qwen2.5vl:7b

# ── Route C — OCR + LLM cleanup (explicit client choice, never auto-triggered) ─
# If the client picks route=ocr_fallback, this LLM structures the extracted text
GROQ_API_KEY=your_groq_api_key_here

# ── Security & Mesh ────────────────────────────────────────────────────────────
OMNIINTEL_INTERNAL_TOKEN=your_internal_mesh_token_here
CORS_ALLOWED_ORIGINS=https://your-docintel-frontend.vercel.app
ENVIRONMENT=production
