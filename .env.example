# DocIntel — Vision-first document AI pipeline
# Copy this file to .env and fill in your values.
#
# ─────────────────────────────────────────────────────────────────────────────
# ROUTE ARCHITECTURE:
#   Route A  →  Claude Sonnet 4.6 Vision (premium quality, requires ANTHROPIC_API_KEY)
#   Route B  →  Ollama vision model (open-weight, your GPU or a cloud Ollama endpoint)
#   Route C  →  Tesseract OCR + LLM cleanup (automatic fallback, no GPU needed)
# ─────────────────────────────────────────────────────────────────────────────


# ─── Route A: Claude Vision (premium) ────────────────────────────────────────
ANTHROPIC_API_KEY=
LLM_VISION_ROUTE_A=anthropic/claude-sonnet-4-6


# ─── Route B: Ollama Vision ───────────────────────────────────────────────────
#
# Step 1: Choose your deployment mode
#   local  = Ollama runs on your own machine (consumer GPU, workstation, LAN server)
#   remote = Ollama (or compatible API) runs on a cloud endpoint
#
ROUTE_B_MODE=local

# Step 2: Choose your Ollama vision model
#   Any Ollama vision model works. These are the recommended options:
#   - qwen2.5vl:7b       lighter, works on most GPUs (recommended default)
#   - llama3.2-vision:11b  better quality, requires CUDA compute ≥ 7.5
#   - llama3.2-vision:90b  highest quality, needs large GPU
#   Run: ollama pull qwen2.5vl:7b
#
OLLAMA_MODEL=qwen2.5vl:7b

# Optional: if your primary model fails due to GPU incompatibility, auto-retry with this
OLLAMA_FALLBACK_MODEL=qwen2.5vl:7b


# ── LOCAL mode settings ───────────────────────────────────────────────────────
# (only relevant when ROUTE_B_MODE=local)
#
# Where your Ollama instance is running:
#   - Same machine:  http://localhost:11434   (default)
#   - Docker:        http://ollama:11434
#   - LAN server:    http://192.168.1.100:11434
#
OLLAMA_HOST=http://localhost:11434


# ── REMOTE mode settings ──────────────────────────────────────────────────────
# (only relevant when ROUTE_B_MODE=remote)
#
# Set ROUTE_B_REMOTE_ENDPOINT to any of these:
#
#   Your Lightning AI Studio (via cloudflared tunnel):
#     ROUTE_B_REMOTE_ENDPOINT=https://inference.your-domain.app
#
#   Groq API (uses llama3.2-vision, auto-mapped from OLLAMA_MODEL):
#     ROUTE_B_REMOTE_ENDPOINT=https://api.groq.com/openai/v1
#     GROQ_API_KEY=your-groq-key
#
#   Hugging Face Inference Router (auto-mapped from OLLAMA_MODEL):
#     ROUTE_B_REMOTE_ENDPOINT=https://router.huggingface.co/hf-inference
#     HF_TOKEN=your-hf-token
#
#   Self-hosted Ollama on a VPS/server:
#     ROUTE_B_REMOTE_ENDPOINT=http://your-server-ip:11434
#
ROUTE_B_REMOTE_ENDPOINT=

# Bearer token for the remote endpoint (required for Groq/HF, optional for others)
ROUTE_B_REMOTE_TOKEN=

# Override the model ID sent to the remote endpoint (optional).
# Use when the remote naming convention differs from Ollama tags.
# If not set, DocIntel auto-maps OLLAMA_MODEL using a built-in table.
# Example for Groq: ROUTE_B_REMOTE_MODEL=llama-3.2-11b-vision-preview
ROUTE_B_REMOTE_MODEL=

# Timeout in seconds for Route B inference calls (default: 60)
ROUTE_B_TIMEOUT=60

# Max concurrent chunks when processing large multi-page PDFs with Route B.
# Keep at 1 (sequential) for local/single-GPU setups. Raise for high-end remote endpoints.
ROUTE_B_CHUNK_CONCURRENCY=1

# (Advanced) Pages per Route B chunk — Ollama has smaller context than Claude.
VISION_PAGES_PER_CALL_LOCAL=2

# ── Orchestrator wake hook (optional) ─────────────────────────────────────────
# Only needed when ROUTE_B_MODE=remote AND your remote endpoint is on-demand
# (e.g. Lightning AI Studio managed by the Orchestrator service).
# Leave empty if your remote is always-on (Groq, HF, own server).
ORCHESTRATOR_URL=
ORCH_TOKEN=


# ─── Route C: OCR Fallback ────────────────────────────────────────────────────
# Model for OCR text → structured JSON cleanup. Cost-optimized.
LLM_CLEANUP=anthropic/claude-haiku-4-5


# ─── General LLM Settings ────────────────────────────────────────────────────
LLM_DEFAULT=groq/llama-3.3-70b-versatile
LLM_REASONING=anthropic/claude-sonnet-4-6

# API Keys (only needed for the features you use)
GROQ_API_KEY=
HF_TOKEN=
OPENAI_API_KEY=
GEMINI_API_KEY=


# ─── Performance & Limits ─────────────────────────────────────────────────────
MAX_PDF_PAGES=200
BATCH_MAX_CONCURRENCY=5
VISION_PAGES_PER_CALL=8


# ─── CORS & Security ──────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:8001,http://localhost:3000
OMNIINTEL_INTERNAL_TOKEN=
REQUIRE_INTERNAL_TOKEN=false


# ─── Logging & Telemetry ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
TELEMETRY_OPT_OUT=false

# Playwright E2E testing credentials & Staging endpoints
E2E_ADMIN_PASSWORD=change_me_e2e_password
STAGING_INTELAI_URL=https://intelai-bwhp.onrender.com
STAGING_DOCINTEL_URL=https://docintel-mm79.onrender.com
STAGING_AGENTKIT_URL=https://agentkit-sbz5.onrender.com
STAGING_RAGEVAL_URL=https://rageval-4xh5.onrender.com
STAGING_VOICEFLOW_URL=https://voiceflow-riao.onrender.com
STAGING_STREAMPULSE_URL=https://streampulse-gv4o.onrender.com
