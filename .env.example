# DocIntel — Vision-first document AI
# Copy to .env and fill in your real keys

# LLM Models
LLM_DEFAULT=groq/llama-3.3-70b-versatile
LLM_REASONING=anthropic/claude-sonnet-4-6
LLM_VISION_ROUTE_A=anthropic/claude-sonnet-4-6  # Route A: Claude Sonnet 4.6 Vision
LLM_VISION_LOCAL=ollama/llama-3.2-vision        # Route B: Llama 3.2 Vision or Qwen 2.5-VL
LLM_CLEANUP=anthropic/claude-haiku-4-5          # Route C: OCR cleanup

# Route Configuration
VISION_PROVIDER=vision_local                    # Route B selector: vision_local|hf|groq
MAX_PDF_PAGES=200
BATCH_MAX_CONCURRENCY=5

# API Keys
GROQ_API_KEY=
ANTHROPIC_API_KEY=
HF_TOKEN=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434

# CORS & Security
CORS_ALLOWED_ORIGINS=http://localhost:8001,http://localhost:3000
OMNIINTEL_INTERNAL_TOKEN=
REQUIRE_INTERNAL_TOKEN=false

# Logging & Telemetry
LOG_LEVEL=INFO
TELEMETRY_OPT_OUT=true
